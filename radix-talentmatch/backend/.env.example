[TEMPLATE]
# Optional local configuration
RADIX_DB_PATH=./profiles.db
CORS_ORIGINS=http://localhost:5173
# Optional research store (defaults to data/company_intelligence/)
RADIX_INTEL_PATH=./company_intelligence

# ---- Company Intelligence Lab: LLM research agents (all optional) ----
# Any one key enables verified company research; all three enable consensus.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL_2=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Optional: team Supabase snapshot (read-only, PostgREST anon key) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
